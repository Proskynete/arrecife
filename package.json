{
  "name": "@eduardoalvarez/arrecife",
  "version": "0.6.0",
  "description": "The component library of Eduardo Álvarez’s visual identity",
  "license": "MIT",
  "author": "Eduardo Esteban Álvarez Castañeda <soy@eduardoalvarez.dev>",
  "homepage": "https://arrecife.eduardoalvarez.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Proskynete/arrecife.git"
  },
  "bugs": {
    "url": "https://github.com/Proskynete/arrecife/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "assets",
    "llms.txt",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "require": "./dist/tokens/index.cjs"
    },
    "./tokens/theme.css": "./dist/tokens/theme.css",
    "./variants": {
      "types": "./dist/variants/index.d.ts",
      "import": "./dist/variants/index.js",
      "require": "./dist/variants/index.cjs"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "require": "./dist/theme/index.cjs"
    },
    "./brand": {
      "types": "./dist/brand/index.d.ts",
      "import": "./dist/brand/index.js",
      "require": "./dist/brand/index.cjs"
    },
    "./social": {
      "types": "./dist/social/index.d.ts",
      "import": "./dist/social/index.js",
      "require": "./dist/social/index.cjs"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "require": "./dist/icons/index.cjs"
    },
    "./og": {
      "types": "./dist/og/index.d.ts",
      "import": "./dist/og/index.js",
      "require": "./dist/og/index.cjs"
    },
    "./shiki": {
      "types": "./dist/shiki/index.d.ts",
      "import": "./dist/shiki/index.js",
      "require": "./dist/shiki/index.cjs"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "import": "./dist/form/index.js",
      "require": "./dist/form/index.cjs"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "import": "./dist/chart/index.js",
      "require": "./dist/chart/index.cjs"
    },
    "./llms.txt": "./llms.txt",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "arrecife": "./dist/doctor.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm check:tokens && pnpm check:namespace && tsup && node scripts/add-use-client.mjs && pnpm build:tokens && pnpm build:doctor && pnpm build:llms",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:doctor": "node scripts/build-doctor.mjs",
    "build:llms": "node scripts/build-llms.mjs",
    "check:tokens": "node scripts/check-tokens-purity.mjs",
    "check:namespace": "node scripts/check-tokens-namespace.mjs",
    "check:llms": "node scripts/build-llms.mjs --check",
    "check:copy": "node scripts/check-copy-language.mjs",
    "check:decisions": "node scripts/check-decisions.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check:exports": "node scripts/check-package-exports.mjs",
    "check:release": "node scripts/check-release-config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:dark && pnpm test:light",
    "test:watch": "vitest --project storybook",
    "storybook": "pnpm build:tokens && storybook dev -p 6006",
    "build-storybook": "pnpm build:tokens && storybook build",
    "prepublishOnly": "pnpm build",
    "test:unit": "vitest run --project unit",
    "test:dark": "vitest run --project storybook",
    "test:light": "STORYBOOK_THEME=light vitest run --project storybook"
  },
  "peerDependencies": {
    "@phosphor-icons/react": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "recharts": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@phosphor-icons/react": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.5",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.87.0",
    "recharts": "^3.10.1",
    "storybook": "^10.5.10",
    "storybook-addon-pseudo-states": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "react-day-picker": "^10.0.1",
    "tailwind-merge": "^3.6.0"
  }
}
