{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "component": "",
      "include-component-in-tag": false,
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "🚀 Novedades"
        },
        {
          "type": "fix",
          "section": "🐛 Correcciones"
        },
        {
          "type": "perf",
          "section": "⚡ Rendimiento"
        },
        {
          "type": "refactor",
          "section": "🔧 Mantenimiento"
        },
        {
          "type": "docs",
          "section": "📚 Documentación"
        },
        {
          "type": "test",
          "section": "🧪 Pruebas"
        },
        {
          "type": "build",
          "section": "📦 Dependencias"
        },
        {
          "type": "ci",
          "section": "🚀 CI/CD"
        },
        {
          "type": "style",
          "section": "💅 Estilo",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "🔧 Mantenimiento",
          "hidden": true
        }
      ]
    }
  },
  "pull-request-header": "Esta rama corta la versión. Al mergear, se crea el tag, el release y se publica en npm. NO cambies el título: release-please lee la versión de vuelta desde él."
}
